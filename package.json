{
  "name": "mono-lib-boilerplate",
  "version": "0.0.0",
  "type": "module",
  "description": "A simple mono library boilerplate",
  "repository": "git+https://github.com/un-ts/mono-lib-boilerplate.git",
  "author": "JounQin <admin@1stg.me> (https://www.1stG.me)",
  "funding": "https://opencollective.com/unts",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "build": "concurrently -r 'yarn:build:*'",
    "build:r": "r -f cjs",
    "build:tsc": "tsc -b",
    "clean": "rimraf -g .type-coverage coverage dist '.*cache' 'packages/**/{lib,*.tsbuildinfo}'",
    "dev": "vitest",
    "docs": "vite",
    "format": "prettier --write .",
    "lint": "concurrently -r 'yarn:lint:*'",
    "lint:es": "eslint . --cache",
    "lint:style": "stylelint . --cache",
    "lint:tsc": "tsc --noEmit",
    "prepare": "simple-git-hooks && yarn-berry-deduplicate || exit 0",
    "release": "yarn build && changeset publish",
    "serve": "sirv dist -s",
    "test": "vitest run",
    "typecov": "type-coverage",
    "version": "changeset version && yarn --no-immutable"
  },
  "devDependencies": {
    "@1stg/browserslist-config": "^3.0.0",
    "@1stg/common-config": "^17.0.0",
    "@1stg/stylelint-config": "^8.0.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.0.0",
    "@eslint-react/eslint-plugin": "^5.0.0",
    "@mdx-js/rollup": "^3.1.0",
    "@pkgr/rollup": "^7.0.0",
    "@shikijs/rehype": "^4.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/web": "^0.0.359",
    "@vercel/analytics": "^2.0.0",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "@vitest/eslint-plugin": "^1.1.43",
    "concurrently": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "github-markdown-css": "^5.8.1",
    "nano-staged": "^1.0.0",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.12.1",
    "sirv-cli": "^3.0.1",
    "stylelint": "^17.0.0",
    "tsx": "^4.19.3",
    "type-coverage": "^2.29.7",
    "typescript": "^7.0.0",
    "vite": "^6.3.2",
    "vitest": "^3.1.1",
    "yarn-berry-deduplicate": "^7.0.0"
  },
  "resolutions": {
    "prettier": "^3.5.3"
  },
  "browserslist": [
    "extends @1stg/browserslist-config/modern"
  ],
  "commitlint": {
    "extends": "@1stg"
  },
  "prettier": "@1stg/prettier-config",
  "stylelint": {
    "extends": "@1stg/stylelint-config"
  },
  "typeCoverage": {
    "atLeast": 100,
    "cache": true,
    "detail": true,
    "ignoreAsAssertion": true,
    "ignoreNonNullAssertion": true,
    "showRelativePath": true,
    "strict": true,
    "update": true
  }
}
